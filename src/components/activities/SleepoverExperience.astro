---
import ActivityImagePlaceholder from './ActivityImagePlaceholder.astro';
---

<section class="sleepover" aria-labelledby="sleepover-title">
	<div class="sleepover__feature">
		<div class="activities-container">
			<div class="activities-section-head sleepover__feature-heading">
				<div>
					<p class="activities-eyebrow">Featured experience</p>
					<h2 id="sleepover-title">Maderas Volcano Sleepover</h2>
				</div>
				<p>An immersive overnight concept. Full experience details to follow.</p>
			</div>
			<ActivityImagePlaceholder label="Maderas sleepover / feature image" variant="dark" className="sleepover__feature-image" />
		</div>
	</div>

	<div class="sleepover__details">
		<div class="activities-container">
			<div class="sleepover__story-grid">
				<div class="sleepover__story">
					<p class="activities-eyebrow">The story</p>
					<h3>Up the volcano, into the<br /> night</h3>
					<p>Provisional story copy will describe the route, the overnight atmosphere and the return to Tiki.</p>
					<blockquote>“A placeholder for a first-hand note from the mountain.”</blockquote>
				</div>
				<div class="sleepover__included">
					<h3>What is included</h3>
					<p>Final inclusions have not yet been provided.</p>
					<ul>
						<li>Guide details — to confirm</li>
						<li>Sleep setup — to confirm</li>
						<li>Food and water — to confirm</li>
						<li>Transport — to confirm</li>
					</ul>
				</div>
			</div>

			<div class="sleepover__gallery" aria-labelledby="sleepover-gallery-title">
				<div class="sleepover__gallery-heading">
					<h3 id="sleepover-gallery-title">The route in frames</h3>
					<span class="activities-eyebrow">Horizontal gallery</span>
				</div>
				<div class="sleepover__gallery-track">
					<ActivityImagePlaceholder label="Sleepover gallery / arrival" />
					<ActivityImagePlaceholder label="Sleepover gallery / trail" variant="dark" />
					<ActivityImagePlaceholder label="Next image" />
				</div>
			</div>

			<div class="sleepover__extension">
				<div>
					<p class="activities-eyebrow">Add another adventure</p>
					<h3>Extend the route</h3>
					<p>Space for an optional companion experience. Details to be confirmed.</p>
				</div>
				<ActivityImagePlaceholder label="Additional adventure" variant="dark" />
			</div>

			<div class="sleepover__practical">
				<div class="activities-section-head">
					<div>
						<p class="activities-eyebrow">Practical information</p>
						<h3>Before setting out</h3>
					</div>
					<p>All practical details remain provisional until confirmed.</p>
				</div>
				<dl>
					<div><dt>Duration</dt><dd>To be confirmed</dd></div>
					<div><dt>Difficulty</dt><dd>To be confirmed</dd></div>
					<div><dt>Meeting point</dt><dd>To be confirmed</dd></div>
					<div><dt>What to bring</dt><dd>List to follow</dd></div>
				</dl>
			</div>

			<div class="sleepover__enquiry">
				<div>
					<h3>Interested in the sleepover?</h3>
					<p>Ask the Tiki team for current details and availability.</p>
				</div>
				<a class="button button--small" href="#consulta-actividades">Consulta Directa</a>
			</div>
		</div>
	</div>
</section>
