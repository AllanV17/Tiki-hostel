---
interface Props {
	label: string;
	variant?: 'light' | 'dark';
	className?: string;
}

const { label, variant = 'light', className = '' } = Astro.props;
---

<div
	class:list={['activity-image-placeholder', `activity-image-placeholder--${variant}`, className]}
	role="img"
	aria-label={`${label}. Imagen pendiente de seleccionar.`}
>
	<span class="activity-image-placeholder__label" aria-hidden="true">{label}</span>
	<span class="activity-image-placeholder__pending" aria-hidden="true">Image to be selected</span>
</div>
