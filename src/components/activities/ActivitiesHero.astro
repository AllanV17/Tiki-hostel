---
import ActivityImagePlaceholder from './ActivityImagePlaceholder.astro';
---

<section class="activities-hero activities-container" aria-labelledby="activities-title">
	<div class="activities-hero__intro">
		<div>
			<p class="activities-eyebrow activities-eyebrow--green">Ometepe — move with the island</p>
			<h1 id="activities-title">Days shaped by water,<br /> earth and fire</h1>
		</div>
		<p class="activities-hero__summary">A provisional introduction to slow adventures across Ometepe.</p>
	</div>
	<div class="activities-hero__visuals">
		<ActivityImagePlaceholder label="Activities hero / wide landscape" className="activities-hero__image" />
		<aside class="activities-hero__aside" aria-label="Ways into the landscape">
			<span class="activities-hero__number">03</span>
			<div>
				<h2>Ways into the landscape</h2>
				<p>Water, trail and saddle — details to follow.</p>
			</div>
		</aside>
	</div>
</section>
