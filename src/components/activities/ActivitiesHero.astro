---
import ActivityImagePlaceholder from './ActivityImagePlaceholder.astro';
---

<section class="activities-hero activities-container" aria-labelledby="activities-title">
	<div class="activities-hero__intro">
		<div>
			<p class="activities-eyebrow activities-eyebrow--green">Ometepe — muévete al ritmo de la isla</p>
			<h1 id="activities-title">Días moldeados por el agua,<br /> la tierra y el fuego</h1>
		</div>
		<p class="activities-hero__summary">Una introducción provisional a las aventuras sin prisa por Ometepe.</p>
	</div>
	<div class="activities-hero__visuals">
		<ActivityImagePlaceholder label="Portada de actividades / paisaje amplio" className="activities-hero__image" />
		<aside class="activities-hero__aside" aria-label="Formas de explorar el paisaje">
			<span class="activities-hero__number">03</span>
			<div>
				<h2>Formas de explorar el paisaje</h2>
				<p>Agua, senderos y paseos a caballo — detalles pendientes.</p>
			</div>
		</aside>
	</div>
</section>
