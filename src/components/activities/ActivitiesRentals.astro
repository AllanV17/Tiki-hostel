---
import ActivityImagePlaceholder from './ActivityImagePlaceholder.astro';

const rentals = [
	{ name: 'Scooter', number: '01', image: 'Alquiler de scooter' },
	{ name: 'Cuatrimoto', number: '02', image: 'Alquiler de cuatrimoto' },
	{ name: 'Bicicleta', number: '03', image: 'Alquiler de bicicleta' },
];
---

<section class="activities-rentals activities-container" aria-labelledby="rentals-title">
	<div class="activities-section-head">
		<div>
			<p class="activities-eyebrow">Explora a tu ritmo</p>
			<h2 id="rentals-title">Recorre los caminos a tu<br /> ritmo</h2>
		</div>
		<p>Alquileres sencillos para recorrer la isla por tu cuenta.</p>
	</div>
	<div class="activities-rentals__grid">
		{rentals.map((rental) => (
			<article class="rental-card">
				<div class="rental-card__heading">
					<h3>{rental.name}</h3>
					<span>{rental.number}</span>
				</div>
				<ActivityImagePlaceholder label={rental.image} />
				<div class="rental-card__bottom">
					<p>Detalles del alquiler — por confirmar</p>
					<a href="#consulta-actividades">Consulta a Tiki <span aria-hidden="true">→</span></a>
				</div>
			</article>
		))}
	</div>
</section>
