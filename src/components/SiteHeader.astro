---
import { Image } from 'astro:assets';
import logo from '../assets/tiki-hostel-logo-blanco.png';
import { withBase } from '../utils/withBase';

interface Props {
	variant?: 'overlay' | 'light';
	activePage?: 'home' | 'hostel' | 'activities' | 'contact';
}

const { variant = 'overlay', activePage = 'home' } = Astro.props;
const isHome = activePage === 'home';
const isHostel = activePage === 'hostel';
const isActivities = activePage === 'activities';
const isContact = activePage === 'contact';
const homeHref = isHome ? '#inicio' : withBase('/');
const hostelHref = withBase('/hostal/');
const contactHref = isActivities ? '#consulta-actividades' : isHostel ? '#consulta-hostal' : isContact ? '#whatsapp' : '#contacto';
const activitiesHref = withBase('/actividades/');
const contactPageHref = withBase('/contacto/');
---

<header class:list={['site-header', variant === 'light' && 'site-header--light']}>
	<div class="site-header__inner container">
		<a class="brand" href={homeHref} aria-label="Tiki Hostel Ometepe. Ir al inicio">
			<span class="brand__logo-frame">
				<Image src={logo} alt="" class="brand__logo" loading="eager" />
			</span>
		</a>

		<nav class="desktop-nav" aria-label="Navegación principal">
			<a href={homeHref} aria-current={isHome ? 'page' : undefined}>Inicio</a>
			<a href={hostelHref} aria-current={isHostel ? 'page' : undefined}>Hostal</a>
			<a href={activitiesHref} aria-current={isActivities ? 'page' : undefined}>Actividades</a>
			<a href={contactPageHref} aria-current={isContact ? 'page' : undefined}>Contacto</a>
			<a class="button button--small" href={contactHref} data-link-placeholder={!isActivities ? '' : undefined} aria-label={!isActivities ? 'Consulta directa, enlace pendiente de configurar' : undefined}>Consulta Directa</a>
		</nav>

		<details class="mobile-nav">
			<summary>Menú</summary>
			<nav class="mobile-nav__links" aria-label="Navegación móvil">
				<a href={homeHref} aria-current={isHome ? 'page' : undefined}>Inicio</a>
				<a href={hostelHref} aria-current={isHostel ? 'page' : undefined}>Hostal</a>
				<a href={activitiesHref} aria-current={isActivities ? 'page' : undefined}>Actividades</a>
				<a href={contactPageHref} aria-current={isContact ? 'page' : undefined}>Contacto</a>
				<a class="button button--small" href={contactHref} data-link-placeholder={!isActivities ? '' : undefined} aria-label={!isActivities ? 'Consulta directa, enlace pendiente de configurar' : undefined}>Consulta Directa</a>
			</nav>
		</details>
	</div>
</header>
