---
import { withBase } from '../../utils/withBase';
interface Props {
	activePage?: 'hostel' | 'contact';
}
const { activePage = 'hostel' } = Astro.props;
---

<footer class="hostel-footer">
	<div class="hostel-container">
		<div class="hostel-footer__main">
			<div class="hostel-footer__brand">
				<a href={withBase('/')}>Tiki Hostel</a>
				<p>Un refugio de madera en Isla de Ometepe, Rivas, Nicaragua.</p>
			</div>
			<nav class="hostel-footer__links" aria-label="Secciones del sitio">
				<h2>Explorar</h2>
				<a href={withBase('/')}>Inicio</a>
				<a href={withBase('/hostal/')} aria-current={activePage === 'hostel' ? 'page' : undefined}>Hostal</a>
				<a href={withBase('/actividades/')}>Actividades</a>
				{activePage === 'contact' && <a href={withBase('/contacto/')} aria-current="page">Contacto</a>}
			</nav>
			<div class="hostel-footer__contact">
				<h2>Contacto y reserva</h2>
				<a href={activePage === 'contact' ? '#whatsapp' : '#consulta-hostal'} data-link-placeholder>Consulta directa</a>
				<span>Correo de contacto pendiente</span>
			</div>
		</div>
		<div class="hostel-footer__bottom">
			<p>© 2026 Tiki Hostel Ometepe. Rivas, Nicaragua.</p>
			<p>Entre dos volcanes</p>
		</div>
	</div>
</footer>
