---
import HostelImagePlaceholder from './HostelImagePlaceholder.astro';
---

<section class="hostel-hero" aria-labelledby="hostel-title">
	<div class="hostel-container">
		<div class="hostel-hero__intro">
			<div>
				<p class="hostel-eyebrow hostel-eyebrow--green">Ometepe — una casa entre volcanes</p>
				<h1 id="hostel-title">El hostal</h1>
			</div>
			<p>Un refugio de madera para bajar el ritmo y habitar la isla con calma.</p>
		</div>
		<div class="hostel-hero__media">
			<HostelImagePlaceholder label="Hostal / fotografía protagonista" className="hostel-hero__image" />
			<aside class="hostel-hero__note" aria-label="Introducción al hostal">
				<span class="hostel-hero__number">01</span>
				<div>
					<h2>Una estancia<br /> cerca de la isla</h2>
					<p>Texto introductorio provisional para presentar el carácter del hostal.</p>
				</div>
			</aside>
		</div>
	</div>
</section>
