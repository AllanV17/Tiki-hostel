---
const modules = [
	{ number: '01', title: 'Servicio por definir' },
	{ number: '02', title: 'Comodidad por definir' },
	{ number: '03', title: 'Servicio por definir' },
	{ number: '04', title: 'Comodidad por definir' },
];
---

<section class="hostel-services" aria-labelledby="hostel-services-title">
	<div class="hostel-container">
		<header class="hostel-section-head hostel-services__heading">
			<div>
				<p class="hostel-eyebrow">Servicios y comodidades</p>
				<h2 id="hostel-services-title">Una base modular para<br class="desktop-break" /> completar después</h2>
			</div>
			<p class="hostel-services__status">Contenido provisional</p>
		</header>
		<div class="hostel-services__grid">
			{modules.map((module) => (
				<article class="hostel-service">
					<span class="hostel-service__number">{module.number}</span>
					<h3>{module.title}</h3>
					<p>Contenido provisional — por confirmar</p>
				</article>
			))}
		</div>
	</div>
</section>
