---
import { withBase } from '../utils/withBase';
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__main">
			<div class="site-footer__brand">
				<a class="brand brand--footer" href="#inicio">
					<span class="brand__name">Tiki Hostel</span>
				</a>
				<p class="provisional-copy">Tu refugio de madera y contemplación en la Isla de Ometepe, Rivas, Nicaragua.</p>
			</div>
			<div class="site-footer__links">
				<div class="footer-group">
					<h2>Secciones</h2>
					<a href="#arquitectura">Hostal</a>
					<a href={withBase('/actividades/')}>Actividades</a>
					<a href="#experiencia">Entorno</a>
				</div>
				<div class="footer-group">
					<h2>Contacto y Reserva</h2>
					<h2>Booking</h2>
					<h2>Airbnb</h2>
					<a href="#contacto" data-link-placeholder aria-label="Consulta directa, enlace pendiente de configurar">Consulta Directa</a>
					
				</div>
			</div>
		</div>
		<div class="site-footer__bottom">
			<p>© 2026 Tiki Hostel Ometepe. Rivas, Nicaragua.</p>
		</div>
	</div>
</footer>
